# TRUSTWEDGE - VARIABLES D'ENVIRONNEMENT (modèle versionné, sans secret réel)
#
# Ne pas remplir ce fichier à la main : générer un ".env" exploitable avec
#   node scripts/init-environment.js
# qui remplace chaque "__GENERATE__" par une valeur aléatoire cryptographiquement sûre et
# laisse intactes les valeurs déjà présentes dans un ".env" existant (script idempotent).
# Détail complet : docs/10-INITIALISATION-ENVIRONNEMENT.md

# IP LAN/publique ou domaine par lequel la machine sera jointe une fois déployée.
# "localhost" en développement (comportement inchangé). Pilote les origines CORS
# supplémentaires et les routes Blockscout dédiées de Kong (scripts/kong-setup.sh) — voir
# docs/04-DEPLOIEMENT-PRODUCTION.md §2bis.
DEPLOY_HOST=localhost

BESU_NETWORK_ID=1337
BESU_RPC_URL=http://besu-node-1:8545
BESU_WS_URL=ws://besu-node-1:8546
BESU_CHAIN_ID=1337
BESU_GAS_PRICE=0
# Clé de signature de la plateforme (détient ISSUER_ROLE on-chain depuis le déploiement du
# contrat) — générée automatiquement, à ne jamais réutiliser d'un environnement à l'autre.
PRIVATE_KEY=__GENERATE__
POSTGRES_USER=trustwedge
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=trustwedge
DATABASE_URL=__GENERATE__
IPFS_API_URL=http://ipfs:5001
IPFS_GATEWAY_URL=http://ipfs:8080
# Renseigné après le déploiement du contrat :
#   npx hardhat run scripts/deploy.js --network besu   (depuis services/nodes)
CONTRACT_ADDRESS=
BLOCKSCOUT_SECRET_KEY_BASE=__GENERATE__
JWT_SECRET=__GENERATE__
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600
NODE_ENV=development
API_PORT=8000
# Tout le trafic API/WS passe par Kong (pas d'accès direct au backend). URL relative (même
# origine que la page servie par Kong) plutôt que "localhost" en dur : ça permet d'accéder à
# l'app depuis un autre appareil du réseau (ex: mobile) via l'IP LAN du poste hôte, sans que
# le JS déjà compilé n'essaie de joindre "localhost" (= l'appareil lui-même) au lieu du
# serveur. REACT_APP_WS_URL n'est pas utilisé (le frontend construit déjà l'URL du WebSocket
# dynamiquement à partir de window.location).
REACT_APP_API_URL=/api
REACT_APP_WS_URL=ws://localhost:8000/ws
REACT_APP_BLOCKCHAIN_RPC=http://localhost:8645
KONG_PG_PASSWORD=__GENERATE__
SECRET_KEY=__GENERATE__
ADMIN_EMAIL=admin@trustwedge.com
ADMIN_PASSWORD=__GENERATE__
# Clé de chiffrement (Fernet) des clés privées DID générées par l'admin.
# Ne JAMAIS régénérer une fois des DID créés : les clés déjà chiffrées deviendraient illisibles
# (c'est pourquoi le script ne régénère jamais une valeur déjà présente).
ENCRYPTION_KEY=__GENERATE__
