# Copier en .env.local et adapter — Expo ne lit pas .env par défaut, ces valeurs sont lues
# via app.json > expo.extra (voir src/config/env.ts) : mettre à jour app.json directement,
# ou passer par `expo-constants` + un plugin dotenv si vous préférez le flux .env classique.

# URL de l'API TrustWedge via Kong. En dev sur appareil physique, remplacer "localhost" par
# l'IP LAN de la machine qui fait tourner docker compose (le téléphone ne résout pas "localhost")
# — garder cette IP alignée avec DEPLOY_HOST dans le .env racine (voir
# docs/04-DEPLOIEMENT-PRODUCTION.md §2bis).
TRUSTWEDGE_API_URL=http://192.168.1.20:8000/api

# RPC Besu — voir l'avertissement dans packages/sdk/src/contractClient.ts : n'est PAS
# accessible depuis un téléphone tant que le port reste publié en 127.0.0.1 uniquement.
TRUSTWEDGE_BESU_RPC_URL=http://127.0.0.1:8645
